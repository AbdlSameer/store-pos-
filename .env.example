# ==============================================================================
# Toy Store POS & Inventory Management System - Environment Configuration
# ==============================================================================

# Server Configuration
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://toystore:toystore_dev_pass@localhost:5432/toystore_db

# Caching & Rate Limiting (Redis)
# Format: redis://[:<password>@]<host>:<port>
REDIS_URL=redis://:redis_dev_pass@localhost:6379

# Authentication & JWT Secrets (Minimum 32 characters required)
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_min_32_chars_long!
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_chars_long!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# QR Code Anti-Tamper Signature (HMAC-SHA256, Minimum 32 characters required)
QR_HMAC_SECRET=your_super_secret_qr_hmac_key_min_32_chars_long!

# Initial Database Seeding Credentials (prisma/seed.ts)
SEED_ADMIN_EMAIL=admin@toystore.com
SEED_ADMIN_PASSWORD=AdminPassword123!

# Cloudinary (Optional: Image upload storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email Notifications (Optional: SendGrid for low stock alerts)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@toystore.com
ADMIN_ALERT_EMAIL=manager@toystore.com

# SMS Notifications (Optional: Twilio for critical out-of-stock SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ADMIN_ALERT_PHONE=

# Client Configuration (apps/client/.env)
VITE_API_URL=http://localhost:4000/api
